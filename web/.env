# 【通用】环境变量 —— web-basic 集成版
# 基于 Web Admin Pro v3.0.2（https://github.com/Daymychen/art-design-pro）

#  版本号
VITE_VERSION = 3.0.2

# 端口号（web-basic 前端开发端口）
VITE_PORT = 5173

# 应用部署基础路径（如部署在子目录 /admin，则设置为 /admin/）
VITE_BASE_URL = /

# 权限模式【 frontend 前端模式 / backend 后端模式 】
# web-basic 使用后端模式：菜单与按钮权限由 Go 后端下发（/api/v1/system/menus/*）
VITE_ACCESS_MODE = backend

# 跨域请求时是否携带 Cookie（本项目用 Bearer Token，保持 false）
VITE_WITH_CREDENTIALS = false

# 是否打开路由信息
VITE_OPEN_ROUTE_INFO = false

# 锁屏加密密钥
VITE_LOCK_ENCRYPT_KEY = s3cur3k3y4adpro
